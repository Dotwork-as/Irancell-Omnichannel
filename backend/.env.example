PORT=8080
DATABASE_PATH=./data/omnichannel.db
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=true            # false only for local plain-HTTP dev
APP_SEED_DEMO_ORDERS=true
RATE_LIMIT_MAX=600
RATE_LIMIT_CHECKOUT_MAX=30
# Optional Cloudflare Turnstile human verification on checkout.
# Leave TURNSTILE_SECRET_KEY empty to keep verification DISABLED
# (local MVP behavior). When set, checkout FAILS CLOSED without a
# valid token — the frontend must send turnstileToken (widget wiring
# required, see frontend/.env.example).
# TURNSTILE_SECRET_KEY=
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
