# URL the browser uses to reach the backend API.
# Defaults to http://localhost:8080/api/v1 when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Optional: Cloudflare Turnstile site key (frontend widget). Only
# needed when the backend enables TURNSTILE_SECRET_KEY verification;
# widget wiring is not implemented in the MVP (fail-closed backend).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
